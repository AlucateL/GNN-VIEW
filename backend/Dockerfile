FROM python:3.13-slim AS deps

COPY requirements.txt /tmp/requirements.txt

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libproj-dev proj-data \
        libspatialindex-dev \
        libgeos-dev \
    && rm -rf /var/lib/apt/lists/*


# CPU wheels for local docker-compose: no GPU on a dev laptop, and the CUDA wheels add
# ~2 GB that would be pulled for nothing.
FROM deps AS builder-cpu

RUN pip3 install --upgrade pip && \
    pip3 install --extra-index-url https://download.pytorch.org/whl/cpu -r /tmp/requirements.txt


# CUDA wheels for production. The deployment cluster shares GPUs via a fractional-VRAM resource;
# the driver comes from the host through the nvidia runtime, so the slim base is fine — the
# wheels carry their own CUDA runtime libraries.
# torch is installed first from the CUDA index and stripped from requirements.txt, otherwise
# the second pip run resolves torch again from PyPI and silently replaces it with the CPU build.
FROM deps AS builder-cuda

RUN pip3 install --upgrade pip && \
    grep -vE '^torch([>=<~].*)?$' /tmp/requirements.txt > /tmp/requirements.notorch.txt && \
    pip3 install --no-cache-dir --retries 10 torch \
        --index-url https://download.pytorch.org/whl/cu126 && \
    pip3 install --no-cache-dir --retries 10 -r /tmp/requirements.notorch.txt && \
    rm -f /tmp/requirements.notorch.txt


# Local dev (docker-compose): dependencies only; source/data mounted as volumes.
FROM builder-cpu AS base

WORKDIR /usr/src/app
ENV PYTHONPATH="/usr/src/app"

CMD ["uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8080"]


FROM python:3.13-slim AS production

RUN apt-get update && apt-get install -y --no-install-recommends \
        libproj-dev proj-data \
        libspatialindex-dev \
        libgeos-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder-cuda /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder-cuda /usr/local/bin /usr/local/bin

WORKDIR /usr/src/app
ENV PYTHONPATH="/usr/src/app"
ENV DATA_ROOT=/usr/data
ENV MODEL_ROOT=/models

# Static data (graphs, zarr windows, scripted checkpoints) lives on the data-neurip
# PVC, mounted at /usr/data. Do not COPY it back into the image.
COPY ./src /usr/src/app
COPY ./neural-lam /models/neural-lam

# Timeline artifacts ship IN THE IMAGE, unlike everything else under data/.
#
# They are ~150 KB for all three models, they are version-controlled, and they are
# regenerated by scripts/precompute_timeline.py whenever the code that reads them changes --
# so binding them to the image tag keeps the two in step. The PVC copy cannot: it is written
# out of band, so a deploy that adds a new series silently keeps serving the old artifact,
# and load_timeline degrades it to mean_error with the other chips disabled.
#
# They must NOT go under /usr/data: the data-neurip PVC mounts over that path (see
# helm/values.yaml) and would hide anything the image put there. services/inference.py
# resolves BUNDLED_TIMELINE_DIR first and falls back to the checkpoint's own directory,
# which is still where an uploaded model's timeline lives.
COPY ./data/paper_checkpoints/*_timeline_errors.npy /usr/src/app/timelines/
ENV BUNDLED_TIMELINE_DIR=/usr/src/app/timelines

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
