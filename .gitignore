# working artifacts of development, not part of the submitted tool, and they
# are the main place stray identifying detail accumulates.
/ANEMOI_INTEGRATION.md
/BBOX_TORCH.md
/CLAUDE.md
/EXPLAIN_MODE.md
/EXPLORE_HIERARCHY.md
/FRONTEND_IMPLEMENTATION_STEPS.md
/FRONTEND_REFINEMENTS.md
/GCS_TIMELINE_FETCH.md
/IG_STEPS.md
/MAP_SPLIT_DESIGN.md
/PERNODE_BASELINE.md
/VENDORED_BALTIC_SEA_FORECASTING.md
/WORKSHOP_REVIEW_ASSESSMENT.md
/WORKSHOP_REVIEW_HANDOFF.md
/.impeccable.md
/.claude/
